# Existing application credentials (copy your actual values into .env.local / Vercel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_BASE_URL=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=

# Choose exactly one browser tag owner: existing GTM setup, or built-in direct tags.
NEXT_PUBLIC_TRACKING_MODE=direct
NEXT_PUBLIC_GTM_ID=GTM-57BVM8H7
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Staging only. NODE_ENV=production ignores test events unless explicitly enabled.
META_TEST_EVENT_CODE=
META_ENABLE_TEST_EVENTS=false

NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Random secret, same value on Vercel and in Supabase Vault.
CRON_SECRET=

# Optional Google Ads refund adjustment integration.
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# Optional migration access. Service-role key cannot execute DDL.
SUPABASE_ACCESS_TOKEN=
