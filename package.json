{
  "name": "favorikoz-site",
  "version": "1.0.0",
  "description": "Modern e-ticaret sitesi - Next.js, TypeScript ve Tailwind CSS ile geliştirilmiştir",
  "private": true,
  "author": "Favorikoz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/favorikoz-site.git"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "ecommerce",
    "react",
    "vercel"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "import:excel": "tsx scripts/import-excel-to-supabase.ts",
    "migrate:products": "tsx scripts/migrate-to-supabase.ts",
    "migrate:protez-tirnak": "tsx scripts/migrate-protez-tirnak-to-tirnak.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "diagnose:ssl": "node scripts/diagnose-ssl.mjs",
    "fix:cloudflare-dns": "node scripts/fix-cloudflare-dns.mjs",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest --testPathPattern=api",
    "test:components": "jest --testPathPattern=components",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:tracking:sql": "node scripts/test-tracking-postgres.mjs",
    "test:tracking:e2e": "node scripts/test-tracking-e2e.mjs",
    "tracking:verify": "node scripts/verify-tracking-setup.mjs",
    "tracking:verify-providers": "node --conditions=react-server --import tsx scripts/verify-tracking-providers.ts",
    "tracking:setup-cron": "node scripts/setup-tracking-cron.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "^16.2.9",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.76.0",
    "@types/iyzipay": "^2.0.3",
    "cloudinary": "^2.9.0",
    "gsap": "^3.14.2",
    "iyzipay": "^2.0.64",
    "lenis": "^1.3.26",
    "lucide-react": "^0.294.0",
    "next": "^14.2.35",
    "next-cloudinary": "^6.16.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.32.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/xlsx": "^0.0.35",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "qs": "^6.14.1"
  }
}
